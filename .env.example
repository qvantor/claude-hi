# ---------------------------------------------------------------------------
# Copy to .env and edit:   cp .env.example .env
# Values are read literally -- do NOT wrap them in quotes.
# ---------------------------------------------------------------------------

# Timezone the schedule is interpreted in.
TZ=Europe/Berlin

# When to run. Standard 5-field cron: minute hour day-of-month month day-of-week
#   0 5 * * *     every day at 05:00
#   30 6 * * 1-5  weekdays at 06:30
#   0 */4 * * *   every 4 hours
CRON_SCHEDULE=0 5 * * *

# What to send to Claude. One line; no surrounding quotes.
CLAUDE_PROMPT=hi claude, how are you

# Directory Claude runs in (mounted from ./workspace on the host).
CLAUDE_WORKDIR=/workspace

# Model alias (opus, sonnet, haiku) or full id. Empty = account default.
CLAUDE_MODEL=sonnet

# Extra flags for the scheduled run. bypassPermissions lets Claude use tools
# unattended -- without it a job that touches files just stalls on a prompt.
CLAUDE_ARGS=--permission-mode bypassPermissions

# Kill a run that hangs, in seconds. 0 disables the timeout.
JOB_TIMEOUT=1800

# Run the job once at container start, instead of waiting for the schedule.
RUN_ON_START=false

# Pin the CLI version (used at build time). latest | stable | e.g. 2.1.238
CLAUDE_CODE_VERSION=latest

# --- Optional: skip the interactive login entirely -------------------------
# Long-lived subscription token from `claude setup-token` on your own machine:
# CLAUDE_CODE_OAUTH_TOKEN=
# Or pay-per-token via the Anthropic Console instead of your subscription:
# ANTHROPIC_API_KEY=
